body {
  margin: 0;
  font-family: Arial, sans-serif;
  text-align: center;
  color: white;
  background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
}

h1 {
  color: #00f7ff;
  text-shadow: 0 0 10px #00f7ff;
}

#score {
  font-size: 28px;
  color: #00ff9f;
}

#time {
  color: #ff4d4d;
  font-weight: bold;
}

#status {
  margin-top: 10px;
  font-size: 22px;
  color: #ffd700;
}

button {
  padding: 12px 20px;
  font-size: 16px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(45deg, #00f7ff, #00ff9f);
  font-weight: bold;
}

/* Area game biar tombol nggak ganggu */
#gameArea {
  position: relative;
  width: 100%;
  height: 400px;
  margin-top: 20px;
  border: 2px dashed white;
}