<!DOCTYPE html>
<html>
<head>
  <title>Game Klik Pro</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <h1>🔥 Game Klik Pro 🔥</h1>

  <p>⏱️ Waktu: <span id="time">30</span></p>
  <p>💯 Score: <span id="score">0</span></p>
