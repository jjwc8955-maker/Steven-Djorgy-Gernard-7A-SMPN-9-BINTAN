let score = 0;
let best = 0;
let time = 30;
let gameOver = true;
let timer;

function startGame() {
  clearInterval(timer); // anti bug

  score = 0;
  time = 30;
  gameOver = false;

  document.getElementById("score").innerHTML = score;
  document.getElementById("time").innerHTML = time;
  document.getElementById("status").innerHTML = "Mulai!! 🔥";

  timer = setInterval(function () {
    time--;
    document.getElementById("time").innerHTML = time;

    if (time <= 0) {
      clearInterval(timer);
      gameOver = true;

      if (score > best) {
        best = score;
        document.getElementById("best").innerHTML = best;
      }

      document.getElementById("status").innerHTML = "GAME OVER 😭";
    }
  }, 1000);
}

function tambahScore() {
  if (gameOver) return;

  score++;
  document.getElementById("score").innerHTML = score;

  let status = "";

  if (score >= 60) {
    status = "ULTRA GOKIL!!!! X1000 😈👾";
  } else if (score >= 50) {
    status = "ULTRA GOKIL!!! X100 😈";
  } else if (score >= 40) {
    status = "GOKIL!! X3 💥";
  } else if (score >= 30) {
    status = "JAGO!! X2 😎";
  } else if (score >= 20) {
    status = "Hoki X1 😏";
  } else if (score >= 10) {
    status = "Lumayan 👍";
  }

  document.getElementById("status").innerHTML = status;

  // tombol random di dalam area
  let btn = document.getElementById("btnKlik");
  let area = document.getElementById("gameArea");

  let maxWidth = area.clientWidth - 100;
  let maxHeight = area.clientHeight - 50;

  btn.style.position = "absolute";
  btn.style.left = Math.random() * maxWidth + "px";
  btn.style.top = Math.random() * maxHeight + "px";
}